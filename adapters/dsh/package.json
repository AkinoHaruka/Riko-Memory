{
  "name": "@agent-memory/dsh-adapter",
  "version": "0.3.0",
  "description": "Riko Memory 的 DSH Minimal preset bundle 与宿主适配器",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkinoHaruka/Riko-Memory.git",
    "directory": "adapters/dsh"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "minimal-memory.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\""
  },
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./minimal-memory.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "file:../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-llm": "file:../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "file:../../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-tools": "file:../../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-subagent": "file:../../../deepseek-harness/packages/subagent/subagent",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
